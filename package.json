{
  "name": "mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mission Control — a single-player space mission design game for the NASA Space Apps Challenge",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "e2e:watch": "cross-env WATCH=1 playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tabler/icons-react": "^3.51.0",
    "howler": "^2.2.4",
    "katex": "^0.19.1",
    "motion": "^14.13.0",
    "phaser": "3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-katex": "^3.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
